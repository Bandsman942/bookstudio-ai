{
  "name": "bookstudio-ai",
  "version": "0.17.0",
  "private": true,
  "description": "BookStudio AI by DTSC — independent editorial workspace",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @bookstudio/web dev",
    "build": "pnpm --filter @bookstudio/web build",
    "typecheck": "pnpm --filter @bookstudio/web typecheck",
    "test": "node --experimental-strip-types --test packages/domain/tests/*.test.mjs && pnpm prefs:check && pnpm test:export && pnpm editor:check && pnpm storage:check && pnpm manuscript-ui:check && pnpm docx:check && pnpm reviewed-docx:check && pnpm docx-split:check && pnpm docx-batch:check && pnpm docx-full:check && pnpm source-scan:check && pnpm toasts:check",
    "test:worker": "python -m unittest discover -s apps/worker-documents/tests -v",
    "db:generate": "pnpm --filter @bookstudio/database generate",
    "db:migrate": "pnpm --filter @bookstudio/database migrate",
    "db:deploy": "pnpm --filter @bookstudio/database run deploy",
    "lint": "pnpm --filter @bookstudio/web lint",
    "release:check": "node tools/check-release.mjs",
    "ui:check": "node tools/check-context-menus.mjs",
    "perf:check": "node tools/check-performance.mjs",
    "prefs:check": "node tools/check-preferences.mjs",
    "test:export": "pnpm --filter @bookstudio/web exec node --experimental-strip-types --test lib/editor-export.test.mjs",
    "editor:check": "node tools/check-editor-ribbon.mjs",
    "storage:check": "node --experimental-strip-types --test apps/web/lib/supabase-storage.test.mjs",
    "manuscript-ui:check": "node tools/check-manuscript-ui.mjs",
    "docx:check": "pnpm --filter @bookstudio/web exec node --experimental-strip-types --test lib/docx-preview.test.mjs",
    "reviewed-docx:check": "pnpm --filter @bookstudio/web exec node --experimental-strip-types --test lib/reviewed-docx-import.test.mjs",
    "docx-split:check": "pnpm --filter @bookstudio/web exec node --experimental-strip-types --test lib/docx-chapter-split.test.mjs",
    "docx-batch:check": "pnpm --filter @bookstudio/web exec node --experimental-strip-types --test lib/reviewed-docx-batch.test.mjs",
    "docx-full:check": "pnpm --filter @bookstudio/web exec node --experimental-strip-types --test lib/docx-full-plan.test.mjs",
    "source-scan:check": "pnpm --filter @bookstudio/web exec node --experimental-strip-types --test lib/source-security-policy.test.mjs",
    "toasts:check": "pnpm --filter @bookstudio/web exec node --experimental-strip-types --test lib/notification-copy.test.mjs && node tools/check-notification-system.mjs"
  }
}

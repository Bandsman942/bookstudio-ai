# Neon — isolated BookStudio project, never reuse DTSC Platform credentials.
DATABASE_URL="postgresql://ROLE:PASSWORD@HOST-POOLER.REGION.aws.neon.tech/bookstudio?sslmode=require"
DIRECT_URL="postgresql://ROLE:PASSWORD@HOST.REGION.aws.neon.tech/bookstudio?sslmode=require"
BOOKSTUDIO_PUBLIC_SIGNUP=false
APP_ORIGIN="http://localhost:3000"
DTSC_API_BASE_URL=""
DTSC_OIDC_ISSUER=""
AI_PROVIDER_ENABLED=false

# Supabase Storage — separate BookStudio AI project; ONLY server variables, no NEXT_PUBLIC secret.
# Bucket already exists and MUST remain private.
SUPABASE_URL="https://nyzvarcnjvfmalfvkelc.supabase.co"
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="Uploaded_books"

# BS-010a1 — strict malware-scan gate: DO NOT enable until an isolated, trusted
# scanner is configured, verified, and produces evidence stored server-side.
# Default false keeps the existing private alpha review workflow unchanged.
BOOKSTUDIO_REQUIRE_SCANNED_SOURCES=false
